{
  "name": "deskleaf-for-obsidian",
  "version": "1.0.0",
  "description": "Deskleaf for Obsidian – calendar, notes, todos and topics",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "TZ=UTC vitest run",
    "test:mutation": "stryker run",
    "check:issue": "node scripts/check-issue-comments.mjs",
    "factory:metrics": "node scripts/factory-metrics.mjs",
    "factory:review": "bash scripts/factory-review.sh",
    "factory:review:daily": "bash scripts/factory-review.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "obsidian": "latest",
    "tslib": "2.6.3",
    "typescript": "5.5.3",
    "vitest": "^4.1.7"
  }
}
