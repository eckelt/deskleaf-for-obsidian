{
  "schemaVersion": 2,
  "product": "obsidian",
  "repository": "eckelt/deskleaf-for-obsidian",
  "declared": {
    "name": "Deskleaf for Obsidian",
    "summary": "Obsidian plugin that shows the calendar next to meeting notes, keeps todos and project priorities in the vault, and tracks Solidtime blocks. A Swift companion reads EventKit calendars and reminders on macOS.",
    "docs": [
      "README.md",
      "specs/overview.md",
      "docs/agent-workflow.md"
    ],
    "containers": [
      {
        "id": "plugin",
        "kind": "plugin",
        "name": "Obsidian plugin",
        "summary": "TypeScript plugin bundled with esbuild: calendar view, sidebar, note manager, CalDAV and iCal readers, Solidtime client.",
        "deployment": "Obsidian desktop and mobile via BRAT pre-release",
        "interfaces": [
          {
            "id": "obsidian-api",
            "direction": "consumes",
            "protocol": "Obsidian plugin API"
          },
          {
            "id": "fastmail-caldav",
            "direction": "consumes",
            "protocol": "CalDAV",
            "summary": "Calendar read and edit"
          },
          {
            "id": "ical-feeds",
            "direction": "consumes",
            "protocol": "iCal over HTTP",
            "summary": "Subscribed calendars"
          },
          {
            "id": "vault-files",
            "direction": "consumes",
            "protocol": "Local Markdown files",
            "summary": "Meeting, person, project notes and todos"
          },
          {
            "id": "solidtime",
            "direction": "consumes",
            "protocol": "Solidtime REST"
          },
          {
            "id": "calendar-sync-binary",
            "direction": "consumes",
            "protocol": "Child process JSON",
            "summary": "EventKit calendars and reminders on macOS"
          }
        ],
        "extract": {
          "typescript": {
            "src": "src",
            "noCycles": true
          }
        }
      },
      {
        "id": "calendar-sync",
        "kind": "daemon",
        "name": "deskleaf-calendar-sync",
        "summary": "Swift binary reading EventKit calendars and reminders, spawned by the plugin on macOS.",
        "deployment": "macOS, shipped as release asset",
        "interfaces": [
          {
            "id": "eventkit",
            "direction": "consumes",
            "protocol": "macOS EventKit"
          },
          {
            "id": "calendar-sync-binary",
            "direction": "provides",
            "protocol": "Child process JSON"
          }
        ]
      }
    ]
  },
